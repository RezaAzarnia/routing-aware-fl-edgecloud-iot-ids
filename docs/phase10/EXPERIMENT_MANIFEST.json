  "preregistration": {
    "status": "FROZEN BEFORE ANY RUN. Independent protocol: NOT part of the Phase 9E final-test hypotheses; touches no Phase 6C/7b/9E artifact.",
    "novelty_claim": "none. history_ucb is a standard UCB1-style historical-feedback baseline; the study measures the cost of the oracle-delivery assumption.",
    "primary_hypotheses": [
      {
        "id": "H1",
        "contrast": "history_ucb - oracle_topk",
        "scenario": "independent",
        "metric": "update_delivery_ratio",
        "expected": "negative (non-oracle ranking delivers fewer updates)"
      },
      {
        "id": "H2",
        "contrast": "history_ucb - oracle_topk",
        "scenario": "independent",
        "metric": "gini",
        "expected": "negative (history_ucb explores every client; participation is more equal)"
      },
      {
        "id": "H3",
        "contrast": "oracle_topk - uniform",
        "scenario": "coupled",
        "metric": "p10_client_recall",
        "expected": "negative (starving unreliable clients hurts their held-out recall when connectivity correlates with minority-class share)"
      },
      {
        "id": "H4",
        "contrast": "history_ucb - oracle_topk",
        "scenario": "coupled",
        "metric": "p10_client_recall",
        "expected": "positive"
      }
    ],
    "secondary": "all other pairwise policy contrasts per scenario for update_delivery_ratio, pdr, delay, gini, never_selected, max_selection_gap, malicious_share_of_selected, worst/mean client holdout recall, best/last AUC and F1; policy x scenario interactions (difference of paired differences)",
    "statistics": "paired by seed (n=5): mean difference, SD, d_z, t-based 95% CI (df=4), seeds favouring each arm, exact sign-flip p (min 0.0625). No multiplicity correction; with n=5 no contrast can be significant under any correction: ALL statements are exploratory; effect sizes and consistency (5/5 seeds) are the evidence.",
    "interpretation_limits": "single simulated network family; one coupling strength (0.8) and one coupling mechanism; UNSW-NB15 only; held-out client recall is measured on each client's own holdout (same distribution), not on independent devices; simulation, not deployment. A null or opposite result is reported as such. The oracle-gap result would quantify the manuscript's largest simulator limitation; it does not establish a new routing algorithm.",
    "validity_notes": "client-level recall without a holdout is not validly measurable (Phase 6C client_level_recall scores training data); the holdout fixes this only for Phase 10 runs",
    "validation_only": true,
    "final_test": "never used"
  },
